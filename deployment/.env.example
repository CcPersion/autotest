# 复制为 deployment/.env 后再启动 Compose；不要把真实值提交到仓库。
AUTOTEST_DB_NAME=autotest
AUTOTEST_DB_USERNAME=autotest
AUTOTEST_DB_PASSWORD=请替换为本机随机数据库密码
AUTOTEST_ADMIN_USERNAME=admin@example.com
AUTOTEST_ADMIN_PASSWORD=请替换为本机管理员密码
AUTOTEST_MASTER_KEY=请替换为至少32字节的Base64主密钥
AUTOTEST_RUNNER_CALLBACK_TOKEN=请替换为本机Runner回传令牌
AUTOTEST_SESSION_COOKIE_SECURE=false
AUTOTEST_API_PORT=8080
AUTOTEST_WEB_PORT=4173
